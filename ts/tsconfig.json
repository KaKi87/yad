{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["bun"],
        "allowImportingTsExtensions": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
